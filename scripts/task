#!/bin/sh
# The one entry point CI and git hooks call, so local and CI checks cannot drift.
set -eu
cd "$(dirname "$0")/.."

usage() {
    echo "usage: scripts/task fmt|fmt:check|lint|test|build|check" >&2
    exit 2
}

run() {
    echo "+ $*" >&2
    "$@"
}

task() {
    case "$1" in
    fmt) run cargo fmt --all ;;
    fmt:check) run cargo fmt --all -- --check ;;
    lint) run cargo clippy --locked --workspace --all-targets --all-features -- -D warnings ;;
    test)
        run cargo test --locked --workspace --all-targets
        run cargo test --locked --workspace --doc
        ;;
    build) run cargo build --locked --workspace --release ;;
    check)
        task fmt:check
        task lint
        task test
        task build
        # The benchmark asserts zero simulation allocations and full collision
        # budgets, so it is a gate, not just a measurement.
        run cargo bench --locked -p ark --bench tick
        ;;
    *) usage ;;
    esac
}

[ "$#" -eq 1 ] || usage
task "$1"
